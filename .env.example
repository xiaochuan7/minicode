# minicode 配置模板 —— 复制成仓库根目录的 .env 再填值。.env 已被 .gitignore 排除，不要提交。
# 起手只需要四行：provider / base_url / api_key / model。

# 协议：anthropic（Anthropic Messages）或 openai（OpenAI 兼容接口，覆盖绝大多数厂商）
MINICODE_PROVIDER=openai
# base_url 约定：openai 协议要带版本路径（.../v1）；anthropic 协议不要带 /v1（程序自己拼）
MINICODE_BASE_URL=https://api.openai.com/v1
MINICODE_API_KEY=
MINICODE_MODEL=gpt-4o

# 模型上下文开关（脱敏器）。两个都缺省为「关」；只有两个同时打开，才允许把控件树送进模型上下文。
# 只开「送树」不开「脱敏」会在装载时直接报错（fail-closed）。
MINICODE_SEND_TREE_TO_MODEL=
MINICODE_REDACTION_ENABLED=
