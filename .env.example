# minicode 配置模板 —— 复制成 .env 后填值。.env 已被 .gitignore 排除。
# 取值可从 C:\Users\22197\.dsh\.credentials.yaml 里对应变量复制。

# 大脑 + 眼睛（同一个模型）
MINICODE_ANTHROPIC_BASE_URL=https://opencode.ai/zen/go
MINICODE_ANTHROPIC_API_KEY=
MINICODE_MODEL=minimax-m3.1-flash-free
MINICODE_SESSION_ID=dsh-union-alpha
MINICODE_HTTP_USER_AGENT=opencode/1.0.0
MINICODE_HTTP_CLIENT=cli

# 可选：第二模型源（主线不需要）
MINICODE_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINICODE_BAILIAN_API_KEY=
MINICODE_BAILIAN_VLM_MODEL=qwen3-vl-plus
MINICODE_ZEN_BASE_URL=https://opencode.ai/zen
MINICODE_ZEN_API_KEY=

# GitHub（备用；需给 token 授 Issues:write + Contents:write 才能用）
GITHUB_TOKEN=
GITHUB_OWNER=xiaochuan7
GITHUB_REPO=minicode
GITHUB_REMOTE_URL=https://github.com/xiaochuan7/minicode.git
GITHUB_USER_NAME=xiaochuan7
GITHUB_USER_EMAIL=2219783254cf@gmail.com
